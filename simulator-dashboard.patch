+# Payment simulator settings. Every value can be overridden on the command line
+# (run `python simulator/simulator.py --help`).
+
+kafka:
+  bootstrap_servers: "localhost:9092,localhost:9094,localhost:9096"
+  payments_topic: payments
+  profiles_topic: card-profiles
+  # Shared contract: acks=all + idempotence. Vincent's benchmarks can override acks with --acks.
+  acks: all
+  enable_idempotence: true
+  linger_ms: 5
+  compression_type: none
+  # Use the same key hash as the Java client (murmur2) so a card_id maps to the
+  # same partition no matter which language produced it.
+  partitioner: murmur2_random
+
+simulation:
+  seed: 42                 # fixed seed: same cards, profiles, amounts and payment IDs every run
+  rate_per_sec: 20         # normal payments per second
+  num_cards: 500           # see the note below on why this is 500 and not 200
+  reserved_cards: 20       # the last N cards get no normal traffic; used by the `limit` injection
+  # 0 = run until stopped (Ctrl+C or `quit`)
+  duration_sec: 0
+  # Rebuild per-card history (counts, averages, last country) from the payments topic at
+  # startup, so a restarted simulator still matches the detector's state and never
+  # triggers false alerts. Set false to skip (e.g. right after `docker compose down -v`).
+  rebuild_state_from_log: true
+  stats_every_sec: 5
+
+# Normal traffic is shaped so it can never trigger a rule on its own.
+# These guards mirror detector/src/main/resources/rules.properties. If you change
+# a detector threshold, change the matching value here.
+guards:
+  max_payments_per_minute: 4    # VELOCITY fires above 5 per 60 s
+  velocity_window_sec: 60
+  geo_window_min: 10            # GEO_MISMATCH window
+  geo_margin_sec: 90            # extra gap required before a normal country change
+  spike_multiplier: 5.0         # AMOUNT_SPIKE: amount > 5x running average
+  spike_min_payments: 5         #   after at least 5 prior payments
+  max_normal_vs_average: 4.0    # normal amounts are capped at 4x the card's running average
+  max_normal_vs_limit: 0.8      # and at 80% of the card's spending limit
+
+# Normal travel keeps traffic "mostly home country": now and then a card takes a trip.
+# The card goes quiet for longer than the GEO_MISMATCH window (like a flight), then pays
+# abroad, so trips never cause false alerts. At 20/sec about 2% of cards are abroad.
+travel:
+  start_probability: 0.0005  # chance per payment that a home card starts a trip
+  return_probability: 0.05   # chance per payment abroad that the card heads home
+
+injection:
+  log_file: simulator/injected.log
+  burst_payments: 8         # VELOCITY: 8 payments...
+  burst_spacing_sec: 1.5    # ...1.5 s apart (about 10 s total)
+  travel_gap_sec: 30        # GEO_MISMATCH: CA payment, then BR payment 30 s later
+  travel_from: CA
+  travel_to: BR
+  spike_multiplier: 10      # AMOUNT_SPIKE: about 10x the card's running average
+  limit_multiplier: 1.3     # OVER_LIMIT: 1.3x the card's spending limit
+  # Scheduled injections (same as --inject): list of types run in order.
+  schedule: []
+  schedule_start_sec: 30    # first scheduled injection after this many seconds
+  schedule_every_sec: 15    # then one every N seconds
+
+# Note on num_cards: the guards allow at most 4 normal payments per card per minute,
+# so the most normal traffic N cards can carry is N * 4 / 60 payments/sec.
+# 200 cards -> 13/sec max, which cannot sustain 20/sec without VELOCITY false alerts.
+# 500 cards -> 33/sec max, so 20/sec runs comfortably.
